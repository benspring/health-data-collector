# --- Oura (OAuth2) ---
# Create an app at https://cloud.ouraring.com/oauth/applications
# Redirect URI must match exactly (default below works with auth_oura.py)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8787/callback
# Filled in by: python auth_oura.py
OURA_ACCESS_TOKEN=
OURA_REFRESH_TOKEN=

# --- Eight Sleep (unofficial app API; email/password login) ---
EIGHT_SLEEP_EMAIL=
EIGHT_SLEEP_PASSWORD=
# IANA timezone for night bucketing (required by trends API)
EIGHT_SLEEP_TIMEZONE=America/New_York
# Optional overrides if Eight rotates mobile-app OAuth constants
# EIGHT_SLEEP_CLIENT_ID=
# EIGHT_SLEEP_CLIENT_SECRET=

# --- Collector defaults ---
# How many days of history to pull (inclusive of today)
LOOKBACK_DAYS=7
OUTPUT_DIR=data
